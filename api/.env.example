PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=socdaal
DB_PASSWORD=change-me
DB_NAME=socdaal

# true only on your own laptop while building; use migrations on the server
DB_SYNCHRONIZE=false

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# First admin account, created by `npm run seed`
ADMIN_NAME=Admin
ADMIN_PHONE=610000000
ADMIN_PIN=123456

# Angular app address, for CORS
CORS_ORIGIN=http://localhost:4200
