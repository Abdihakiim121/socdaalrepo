PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=socdaal
DB_PASSWORD=change-me
DB_NAME=socdaal

# Keep false. Tables are created and changed by migrations: npm run migration:run
DB_SYNCHRONIZE=false

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First admin account, created by `npm run seed`. The PIN must be 6 digits.
ADMIN_NAME=Admin
ADMIN_PHONE=610000000
ADMIN_PIN=123456

# Angular app address, for CORS
CORS_ORIGIN=http://localhost:4200

# Set to true on the server when the API runs behind Nginx
TRUST_PROXY=false
